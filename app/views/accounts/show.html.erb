<% if @trading212_coverage %>
  <%= render DS::Alert.new(message: t("trading212_split.account_coverage", start: @trading212_coverage[:first] || t("trading212_split.none"), end: @trading212_coverage[:last] || t("trading212_split.none"), count: @trading212_coverage[:unclassified]), variant: :warning) %>
<% end %>
<% if @trading212_diagnostics %>
  <%= render DS::Alert.new(message: trading212_diagnostics_message(@trading212_diagnostics), variant: :warning) %>
<% end %>
<% if preview_features_enabled? && @trading212_statement_provider %>
  <%= render DS::Link.new(text: t("trading212_split.statement_title"), href: new_trading212_statement_path(trading212_account_id: @trading212_statement_provider.id)) %>
<% end %>

<%= render UI::AccountPage.new(
      account: @account,
      chart_view: @chart_view,
      chart_period: @period,
      loan_chart: @loan_chart,
      loan_projection: @loan_projection,
      as_of: @as_of,
      active_tab: @tab,
      statement_coverage: @statement_coverage,
      statements: @account_statements,
      reconciliation_statuses: @statement_reconciliation_statuses,
      can_manage_statements: @can_manage_statements
    ) do |account_page| %>
  <%= account_page.with_activity_feed(feed_data: @activity_feed_data, pagy: @pagy, search: @q[:search]) %>
<% end %>
